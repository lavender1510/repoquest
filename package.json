{
  "name": "repoquest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "prisma db push --schema src/server/db/schema.prisma",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate --schema src/server/db/schema.prisma",
    "db:push": "prisma db push --schema src/server/db/schema.prisma",
    "postinstall": "npm run db:generate",
    "release:notes": "node scripts/generate-release-notes.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "@prisma/client": "^6.19.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.5.3",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "engines": { "node": ">=20.9.0" }
}
