# Relative SQLite paths are resolved from src/server/db/schema.prisma
DATABASE_URL="file:./dev.db"
# Optional: fine-grained token with Contents:Read, Issues:Read, Pull requests:Read, Actions:Read, Deployments:Read
GITHUB_TOKEN=""
# Required for reading private repos via token, comma-separated, case-insensitive: owner/repo
GITHUB_ALLOWED_REPOS="lavender1510/repoquest"
# Keep false unless deployment is protected by authentication at the reverse proxy
ALLOW_PRIVATE_REPOS_IN_PRODUCTION="false"
